# Copy to .env and fill in. Never commit the real .env (already gitignored).
TABPFN_TOKEN=

# surrogate = local distilled model (default, 2 ms) | live = hosted TabPFN
# (~3 s, exact original answers) | stub = offline, no token needed
TABPFN_TRANSPORT=surrogate

# Set to require an X-API-Key header on /predict. Leave unset only behind a
# gateway that terminates auth itself.
API_KEY=
