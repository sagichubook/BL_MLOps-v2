FROM python:3.14-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY scripts/ scripts/
COPY assets/ assets/
COPY pyproject.toml .

# BL_REQUIRE_NAME_INDEX=1: in serving, a missing index must fail loudly
# rather than silently make every worker 1.9 GB heavier.
ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    TZ=UTC \
    BL_REQUIRE_NAME_INDEX=1

EXPOSE 8000

# Gate on /ready, not /health: readiness includes the startup canary, which
# is the only check that catches an evicted hosted TabPFN fit.
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8000/ready || exit 1

CMD ["python", "scripts/serve.py"]
